---
import Base from '../../layouts/Base.astro';
import '../../styles/inner.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Checkout (demo). Ar0und." cta={false}>
  <main id="main" class="page">
    <section class="sc-wrap sc-stack order">
      <h1 class="sc-display">Checkout.</h1>
      <p class="order__banner">
        <strong>This is a demo checkout.</strong> Ar0und is a class concept, so no payment is taken, nothing ships,
        and nothing you type here is saved or sent anywhere.
      </p>

      <div data-checkout-empty hidden class="sc-stack">
        <p class="sc-lede">Your cart is empty, so there is nothing to check out.</p>
        <p><a class="cta" href={`${base}/shop`}>Shop the cans</a></p>
      </div>

      <div data-checkout-full hidden class="order__grid">
        <!-- The fields have no name attributes on purpose: even if this form were
             submitted the ordinary way, the browser would send nothing. -->
        <form class="checkout" data-checkout novalidate>
          <fieldset>
            <legend>1. Delivery</legend>
            <p class="checkout__hint">Optional in this demo. Leave them blank if you like.</p>
            <label>Full name <input type="text" autocomplete="off" /></label>
            <label>Email <input type="email" autocomplete="off" data-email /></label>
            <p class="checkout__error" data-email-error hidden>That email address doesn't look right. Fix it or clear the box.</p>
            <label>Street address <input type="text" autocomplete="off" /></label>
            <div class="checkout__row">
              <label>City <input type="text" autocomplete="off" /></label>
              <label>ZIP code <input type="text" inputmode="numeric" autocomplete="off" /></label>
            </div>
          </fieldset>
          <fieldset>
            <legend>2. Payment</legend>
            <p class="checkout__demo">Demo payment. No card needed, nothing is charged.</p>
          </fieldset>
          <button type="submit" class="cta">Place demo order</button>
        </form>

        <aside class="order__summary" aria-label="Order summary">
          <h2 class="order__summary-title">Your order</h2>
          <ul class="order__mini" data-checkout-lines></ul>
          <dl>
            <div><dt>Shipping</dt><dd>Not charged in this demo</dd></div>
            <div data-checkout-discount hidden><dt>Rewards</dt><dd data-checkout-discount-amount></dd></div>
            <div class="order__total"><dt>Total</dt><dd data-checkout-total></dd></div>
          </dl>
          <div class="order__reward">
            <label data-reward-use hidden>
              <input type="checkbox" data-reward-box />
              <span data-reward-label></span>
            </label>
            <p data-reward-earn hidden></p>
            <p data-reward-join hidden>
              <a class="text-link" href={`${base}/rewards`}>Join the rewards club</a> to earn points on this order.
            </p>
          </div>
          <a class="text-link" href={`${base}/cart`}>Edit cart</a>
        </aside>
      </div>

      <noscript><p class="sc-body">The checkout needs JavaScript switched on in your browser.</p></noscript>
    </section>
  </main>

  <script>
    import { cart, catalog, formatMoney } from '../../scripts/site.js';
    import { club, rules, drinkKeys } from '../../scripts/rewards-store.js';
    import { discountFor, settle, stampsFor } from '../../lib/rewards.js';
    const base = (document.documentElement.dataset.base || '').replace(/\/$/, '');
    const lines = cart.lines();
    const totals = cart.totals();
    document.querySelector('[data-checkout-empty]').hidden = lines.length > 0;
    document.querySelector('[data-checkout-full]').hidden = lines.length === 0;

    const list = document.querySelector('[data-checkout-lines]');
    for (const line of lines) {
      const li = document.createElement('li');
      const name = document.createElement('span');
      name.textContent = `${line.qty} × ${line.name}, ${line.detail}`;
      const price = document.createElement('span');
      price.textContent = formatMoney(line.lineCents);
      li.append(name, price);
      list.append(li);
    }
    // Rewards: a member can trade points for money off, and sees what this
    // order will earn. Everyone else gets a pointer to the club.
    const member = club.get();
    const order = { subtotalCents: totals.subtotalCents, keys: stampsFor(lines.map((l) => l.sku), catalog, drinkKeys) };
    const box = document.querySelector('[data-reward-box]');
    const paintTotal = () => {
      const out = settle(member, { ...order, useReward: box.checked }, rules);
      document.querySelector('[data-checkout-discount]').hidden = out.discountCents === 0;
      document.querySelector('[data-checkout-discount-amount]').textContent = `−${formatMoney(out.discountCents)}`;
      document.querySelector('[data-checkout-total]').textContent = formatMoney(out.totalCents);
      if (member.joined) {
        document.querySelector('[data-reward-earn]').textContent =
          `This order earns ${out.earned} ${out.earned === 1 ? 'point' : 'points'}.`;
      }
      return out;
    };
    document.querySelector('[data-reward-join]').hidden = member.joined;
    document.querySelector('[data-reward-earn]').hidden = !member.joined;
    if (discountFor(member, order.subtotalCents, rules) > 0) {
      document.querySelector('[data-reward-use]').hidden = false;
      document.querySelector('[data-reward-label]').textContent =
        `Use ${rules.rewardPoints} of your ${member.points} points for ${formatMoney(rules.rewardCents)} off`;
    }
    box.addEventListener('change', paintTotal);
    paintTotal();

    const form = document.querySelector('[data-checkout]');
    const email = form.querySelector('[data-email]');
    const emailError = form.querySelector('[data-email-error]');
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      // The one check a real shop would also make: an email, if given, is an email.
      const value = email.value.trim();
      const bad = value !== '' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
      emailError.hidden = !bad;
      email.setAttribute('aria-invalid', bad ? 'true' : 'false');
      if (bad) {
        email.focus();
        return;
      }
      // Keep only what was ordered for the confirmation page. Nothing typed
      // into the delivery fields is stored.
      const out = paintTotal();
      if (member.joined) club.save(out.member);
      try {
        sessionStorage.setItem(
          'around-last-order',
          JSON.stringify({
            lines,
            totals,
            discountCents: out.discountCents,
            totalCents: out.totalCents,
            earned: out.earned,
            member: member.joined,
          })
        );
      } catch (err) {}
      cart.clear();
      location.href = `${base}/checkout/done`;
    });
  </script>
</Base>
