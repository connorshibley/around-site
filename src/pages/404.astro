---
import Base from '../layouts/Base.astro';
import '../styles/inner.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Page not found. Ar0und." description="That page is not on the Ar0und site.">
  <main id="main" class="page">
    <section class="sc-wrap sc-stack">
      <h1 class="sc-display">Wrong turn.</h1>
      <p class="sc-lede">That page isn't on the map. The three drinks are.</p>
      <p><a class="cta" href={`${base}/shop`}>Shop the cans</a></p>
      <p><a class="text-link" href={`${base}/`}>Back to the start</a></p>
    </section>
  </main>
</Base>
